---
/**
 * The full-screen map, the day card and the year scrubber.
 * Rendered on the server already focused on `initialYear`, then driven by
 * map-client.ts. It is persisted across client-side navigations, so the
 * camera keeps moving smoothly while the overlay changes.
 */
import { WORLD_W, WORLD_H, land110Path, spherePath } from '../../lib/geo.ts';
import { worldView, pointView, viewBox, SERVER_FRAME, type Frame } from '../../lib/camera.ts';
import { YEARS, dayHref, decadeOf, type DayIndexEntry } from '../../lib/days.ts';
import { YEAR_MIN, YEAR_MAX } from '../../schema.ts';
import { useUI } from '../../i18n';

interface Props {
  index: DayIndexEntry[];
  initialYear: number;
  overlayOpen: boolean;
  /** 'world' renders the whole world first (the home page flies in after load). */
  camera?: 'world' | 'day';
}

const ui = useUI();
const { index, initialYear, overlayOpen, camera = 'day' } = Astro.props;
const byYear = new Map(index.map((d) => [d.year, d]));
const selected = byYear.get(initialYear);

const frame: Frame = overlayOpen
  ? { ...SERVER_FRAME, fx: (1440 - 576) / 2 / 1440, freeWidth: 1440 - 576 }
  : SERVER_FRAME;
const view = selected && camera === 'day' ? pointView(selected.x, selected.y, selected.zoom, WORLD_W, WORLD_H, frame) : worldView(WORLD_W, WORLD_H, frame);
const vb = viewBox(view, frame).map((n) => Math.round(n * 100) / 100).join(' ');
const pxToWorld = view[2] / frame.width;

const pointState = (year: number) => (year === initialYear ? 'current' : year < initialYear ? 'past' : 'future');
const json = JSON.stringify({ days: index, world: [WORLD_W, WORLD_H], min: YEAR_MIN, max: YEAR_MAX }).replace(/</g, '\\u003c');
const pct = (y: number) => ((y - YEAR_MIN) / (YEAR_MAX - YEAR_MIN)) * 100;
---

<div
  id="map-shell"
  class="map-shell"
  transition:persist="map-shell"
  data-initial-year={initialYear}
>
  <script type="application/json" id="days-index" set:html={json} />

  <svg
    class="map"
    viewBox={vb}
    preserveAspectRatio="xMidYMid slice"
    role="img"
    aria-label={ui.map.label}
    data-world-w={WORLD_W}
    data-world-h={WORLD_H}
  >
    <path class="sphere" d={spherePath()} />
    <path class="land land-lo" d={land110Path()} />
    <path class="land land-hi" d="" />
    <g class="points">
      {
        index.map((d) => (
          <g class="pt" data-year={d.year} data-state={pointState(d.year)} data-draft={d.draft || undefined}>
            <circle class="pt-dot" cx={d.x} cy={d.y} r={(pointState(d.year) === 'current' ? 6 : 3) * pxToWorld} />
            <circle class="pt-hit" cx={d.x} cy={d.y} r={16 * pxToWorld}>
              <title>{ui.map.pointLabel(d.year, d.title)}</title>
            </circle>
          </g>
        ))
      }
    </g>
  </svg>

  <div class="hud">
    <!-- Both cards are always in the DOM; map-client.ts fills one and hides the other. -->
    <div class="card-slot" aria-live="polite">
      <a class="day-card" href={selected ? dayHref(selected.year) : undefined} hidden={!selected}>
        <span class="card-date">
          <span class="card-date-text">{selected?.date}</span>
          <span class="badge" hidden={!selected?.draft}>{ui.map.draft}</span>
        </span>
        <span class="card-title">{selected?.title}</span>
        <span class="card-summary">{selected?.summary}</span>
        <span class="visually-hidden">{ui.map.openDay}</span>
      </a>
      <div class="day-card is-empty" hidden={!!selected}>
        <span class="card-date"><span class="card-date-text">{initialYear}</span></span>
        <span class="card-title">{index.length ? ui.map.notWritten : ui.map.empty}</span>
      </div>
    </div>

    <div
      class="scrubber"
      role="slider"
      tabindex="0"
      aria-label={ui.map.sliderLabel}
      aria-valuemin={YEAR_MIN}
      aria-valuemax={YEAR_MAX}
      aria-valuenow={initialYear}
      aria-valuetext={selected ? `${initialYear}: ${selected.title}` : `${initialYear}: ${ui.map.notWritten}`}
      aria-describedby="scrub-hint"
    >
      <div class="track">
        {
          YEARS.map((y) => {
            const d = byYear.get(y);
            const cls = ['tick', d ? 'written' : 'empty', y % 10 === 0 ? 'decade' : '', y === initialYear ? 'selected' : ''].join(' ');
            return d ? (
              <a class={cls} href={dayHref(y)} data-year={y} tabindex="-1" aria-hidden="true" />
            ) : (
              <span class={cls} data-year={y} aria-hidden="true" />
            );
          })
        }
        <span class="thumb" style={`left:${pct(initialYear)}%`} aria-hidden="true"><span class="thumb-label">{initialYear}</span></span>
      </div>
      <div class="labels" aria-hidden="true">
        {YEARS.filter((y) => y % 10 === 0).map((y) => <span style={`left:${pct(y)}%`} data-decade={decadeOf(y)}>{y}</span>)}
      </div>
    </div>
    <p id="scrub-hint" class="hint">{ui.map.hint}</p>
  </div>
</div>

<script>
  import './map-client.ts';
</script>

<style>
  .map-shell {
    position: fixed;
    inset: 0;
    overflow: hidden;
    background: var(--map-ocean);
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }

  .map {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    display: block;
    cursor: grab;
  }
  .map.is-dragging {
    cursor: grabbing;
  }
  .sphere {
    fill: var(--map-sphere);
  }
  .land {
    fill: var(--map-land);
    stroke: var(--map-coast);
    stroke-width: 0.5px;
    vector-effect: non-scaling-stroke;
    stroke-linejoin: round;
  }
  .land-hi {
    display: none;
  }
  .map.hi-res .land-lo {
    display: none;
  }
  .map.hi-res .land-hi {
    display: inline;
  }

  .pt-dot {
    fill: var(--map-point);
    transition: opacity var(--duration-fast);
  }
  .pt[data-state='past'] .pt-dot {
    fill: var(--map-point-past);
    opacity: var(--map-point-past-opacity);
  }
  .pt[data-state='future'] {
    display: none;
  }
  .pt-hit {
    fill: transparent;
    cursor: pointer;
  }

  .hud {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0 var(--gutter) max(var(--space-3), env(safe-area-inset-bottom));
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    pointer-events: none;
  }
  .hud > * {
    pointer-events: auto;
  }

  /* Fixed height so the free map area (and thus the camera) does not jump between cards. */
  .card-slot {
    max-width: 28rem;
    min-height: 7.25rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    pointer-events: none;
  }
  .day-card[hidden] {
    display: none;
  }
  .day-card {
    pointer-events: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    text-decoration: none;
    color: var(--color-text);
  }
  a.day-card:hover .card-title {
    text-decoration: underline;
  }
  .day-card.is-empty {
    color: var(--color-text-muted);
  }
  .card-date {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    display: flex;
    gap: var(--space-2);
    align-items: center;
  }
  .card-title {
    font-weight: var(--weight-strong);
    line-height: var(--leading-tight);
  }
  .card-summary {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .scrubber {
    position: relative;
    height: var(--scrubber-height);
    padding-top: var(--space-4);
    cursor: pointer;
    outline-offset: 4px;
  }
  .track {
    position: relative;
    display: flex;
    align-items: flex-end;
    height: 1.25rem;
  }
  .tick {
    flex: 1;
    height: 35%;
    margin: 0 0.5px;
    border-radius: 1px;
    background: var(--color-border);
  }
  .tick.decade {
    height: 60%;
  }
  .tick.written {
    height: 100%;
    background: var(--color-text-muted);
  }
  .tick.selected {
    background: var(--color-accent);
  }
  .thumb {
    position: absolute;
    bottom: -4px;
    width: 2px;
    height: calc(100% + 8px);
    margin-left: -1px;
    background: var(--color-accent);
    pointer-events: none;
  }
  .thumb-label {
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%);
    padding: 0 var(--space-1);
    font-size: var(--text-xs);
    font-weight: var(--weight-strong);
    font-variant-numeric: tabular-nums;
    background: var(--map-ocean);
  }
  .labels {
    position: relative;
    height: 1rem;
    margin-top: var(--space-1);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }
  .labels span {
    position: absolute;
    transform: translateX(-50%);
  }
  .labels span:first-child {
    transform: none;
  }
  .labels span:last-child {
    transform: translateX(-100%);
  }
  @media (max-width: 40rem) {
    .labels span:nth-child(even) {
      display: none;
    }
  }
  .hint {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
  @media (hover: none) {
    .hint {
      display: none;
    }
  }

  /* While reading a day the slider steps aside; prev/next live in the overlay. */
  :global(body.overlay-open) .hud {
    visibility: hidden;
  }
</style>
