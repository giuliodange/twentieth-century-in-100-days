---
/** Horizontal ranked bars (continents, countries, themes, people…). */
import { scaleLinear } from 'd3-scale';
import type { Count } from '../../lib/stats.ts';
import { useUI } from '../../i18n';

interface Props {
  data: Count[];
  limit?: number;
  /** Hide categories with value 0 (open lists such as countries hide them anyway). */
  hideZero?: boolean;
  format?: (n: number) => string;
}

const ui = useUI();
const { data, limit = 10, hideZero = false, format = (n: number) => String(n) } = Astro.props;
const rows = (hideZero ? data.filter((d) => d.value > 0) : data);
const shown = rows.slice(0, limit);
const rest = rows.length - shown.length;
const x = scaleLinear().domain([0, Math.max(1, ...rows.map((d) => d.value))]).range([0, 100]);
---

<ol class="bars">
  {
    shown.map((d) => (
      <li>
        <span class="label">{d.href ? <a href={d.href}>{d.label}</a> : d.label}</span>
        <span class="track" aria-hidden="true">
          <span class="bar" style={`width:${x(d.value)}%`} />
        </span>
        <span class="value">{format(d.value)}</span>
      </li>
    ))
  }
</ol>
{rest > 0 && <p class="more muted">{ui.stats.andMore(rest)}</p>}

<style>
  .bars {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
  li {
    display: grid;
    grid-template-columns: minmax(0, 11rem) 1fr auto;
    gap: var(--space-3);
    align-items: center;
    font-size: var(--text-sm);
  }
  .label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .track {
    height: 0.6rem;
    background: var(--chart-track);
    border-radius: 999px;
    overflow: hidden;
  }
  .bar {
    display: block;
    height: 100%;
    background: var(--chart-bar);
    border-radius: 999px;
  }
  .value {
    font-variant-numeric: tabular-nums;
    min-width: 2ch;
    text-align: right;
  }
  .more {
    font-size: var(--text-sm);
    margin: var(--space-2) 0 0;
  }
</style>
