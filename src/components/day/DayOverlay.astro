---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import GoDeeperList from './GoDeeperList.astro';
import { dayHref, formatDate, type Day } from '../../lib/days.ts';
import { useUI } from '../../i18n';

interface Props {
  day: Day;
  prev?: Day;
  next?: Day;
}

const ui = useUI();
const { day, prev, next } = Astro.props;
const d = day.data;
const { Content } = await render(day);

const visuals = import.meta.glob<ImageMetadata>('/src/assets/visuals/*', { eager: true, import: 'default' });
const visual = d.visual ? visuals[`/src/assets/visuals/${d.visual}`] : undefined;
const headingId = `day-${d.year}-title`;
---

<section class="overlay" role="dialog" aria-labelledby={headingId} data-day-page data-year={d.year}>
  <div class="overlay-bar">
    <a href={`/#${d.year}`} class="close" data-close aria-label={ui.day.closeToMap}>
      <span aria-hidden="true">✕</span>
      <span class="close-text">{ui.day.close}</span>
    </a>
  </div>

  <article class="day">
    {d.status === 'draft' && <p class="draft-banner">{ui.day.draftBanner}</p>}
    <header>
      <p class="date">
        <time datetime={d.date}>{formatDate(d.date)}</time>
        <span class="muted"> · {d.place.name}</span>
      </p>
      <h1 id={headingId} tabindex="-1" data-autofocus>{d.title}</h1>
      <p class="summary">{d.summary}</p>
    </header>

    {visual && <Image src={visual} alt="" class="visual" widths={[480, 960]} sizes="(min-width: 900px) 36rem, 100vw" />}

    <div class="story">
      <Content />
    </div>

    <aside class="why">
      <h2>{ui.day.whyItMatters}</h2>
      <p>{d.why_it_matters}</p>
    </aside>

    <dl class="facts">
      <div>
        <dt>{ui.day.place}</dt>
        <dd>
          {d.place.name}<br />
          {d.place.country_then}
          {d.place.country_then !== d.place.country_today && (
            <span class="muted">
              ({ui.day.today}: {d.place.country_today})
            </span>
          )}
          <br />
          <span class="muted">{d.place.continent}</span>
        </dd>
      </div>
      <div>
        <dt>{ui.day.themes}</dt>
        <dd>
          <ul class="chips">
            {d.themes.map((t) => <li><a href={`/go-deeper/?theme=${t}`}>{ui.themes[t]}</a></li>)}
          </ul>
        </dd>
      </div>
      {
        d.people.length > 0 && (
          <div>
            <dt>{ui.day.people}</dt>
            <dd>{d.people.join(', ')}</dd>
          </div>
        )
      }
      {
        d.date_note && (
          <div>
            <dt>{ui.day.dateNote}</dt>
            <dd>{d.date_note}</dd>
          </div>
        )
      }
    </dl>

    {
      d.go_deeper.length > 0 && (
        <section class="go-deeper">
          <h2>{ui.day.goDeeper}</h2>
          <GoDeeperList items={d.go_deeper} />
        </section>
      )
    }

    {
      d.sources.length > 0 && (
        <section class="sources">
          <h2>{ui.day.sources}</h2>
          <ol>
            {d.sources.map((s) => (
              <li>
                <a href={s.url} rel="noopener" target="_blank">{s.title}</a>
              </li>
            ))}
          </ol>
        </section>
      )
    }
  </article>

  <nav class="prev-next" aria-label="Previous and next day">
    {
      prev ? (
        <a href={dayHref(prev.data.year)} data-astro-history="replace" rel="prev">
          <span class="muted">← {ui.day.prev}</span>
          <span>{prev.data.year}</span>
        </a>
      ) : (
        <span />
      )
    }
    {
      next ? (
        <a href={dayHref(next.data.year)} data-astro-history="replace" rel="next" class="next">
          <span class="muted">{ui.day.next} →</span>
          <span>{next.data.year}</span>
        </a>
      ) : (
        <span />
      )
    }
  </nav>
</section>

<style>
  .overlay {
    position: fixed;
    z-index: 40;
    inset: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    background: var(--color-surface);
    animation: overlay-in var(--duration-overlay) var(--ease-out);
  }
  @media (min-width: 900px) {
    .overlay {
      left: auto;
      width: var(--overlay-width);
      border-left: 1px solid var(--color-border);
      box-shadow: var(--shadow-card);
    }
  }
  @keyframes overlay-in {
    from {
      opacity: 0;
      transform: translateX(1.5rem);
    }
  }

  .overlay-bar {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    justify-content: flex-end;
    padding: var(--space-3) var(--gutter);
    padding-top: max(var(--space-3), env(safe-area-inset-top));
    background: linear-gradient(var(--color-surface) 70%, transparent);
  }
  .close {
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .day {
    padding: 0 var(--gutter) var(--space-6);
    max-width: var(--content-width);
  }
  .draft-banner {
    margin: 0 0 var(--space-4);
    padding: var(--space-2) var(--space-3);
    border: 1px dashed var(--color-text-muted);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
  }
  .date {
    margin: 0;
    font-size: var(--text-sm);
  }
  h1 {
    font-size: var(--text-xl);
    margin: var(--space-2) 0 var(--space-3);
  }
  h1:focus {
    outline: none;
  }
  .summary {
    font-size: var(--text-lg);
    line-height: 1.45;
    margin: 0 0 var(--space-5);
  }
  .visual {
    display: block;
    width: 100%;
    height: auto;
    margin: 0 0 var(--space-5);
    border-radius: var(--radius-sm);
  }
  .story :global(blockquote) {
    margin: var(--space-4) 0;
    padding-left: var(--space-4);
    border-left: 2px solid var(--color-border);
    color: var(--color-text-muted);
  }
  .story :global(h2) {
    font-size: var(--text-lg);
    margin-top: var(--space-6);
  }
  h2 {
    font-size: var(--text-md);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: var(--space-6) 0 var(--space-3);
  }
  .why {
    margin-top: var(--space-6);
    padding: var(--space-4);
    background: var(--color-bg);
    border-radius: var(--radius-md);
  }
  .why h2 {
    margin-top: 0;
  }
  .why p {
    margin: 0;
  }
  .facts {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-6) 0 0;
  }
  @media (min-width: 30rem) {
    .facts {
      grid-template-columns: 1fr 1fr;
    }
  }
  .facts dt {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }
  .facts dd {
    margin: var(--space-1) 0 0;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .chips a {
    display: inline-block;
    padding: 0 var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: var(--text-sm);
    text-decoration: none;
  }
  .sources ol {
    padding-left: var(--space-5);
    font-size: var(--text-sm);
  }
  .prev-next {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--gutter) max(var(--space-6), env(safe-area-inset-bottom));
    border-top: 1px solid var(--color-border);
  }
  .prev-next a {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    font-weight: var(--weight-strong);
  }
  .prev-next a span:first-child {
    font-weight: var(--weight-regular);
    font-size: var(--text-sm);
  }
  .prev-next .next {
    text-align: right;
  }
</style>
